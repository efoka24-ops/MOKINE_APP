# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/mokine
DB_HOST=localhost
DB_PORT=27017
DB_NAME=mokine

# JWT — REQUIRED: use a cryptographically random 64-char string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_IN_PRODUCTION
JWT_EXPIRE=7d

# IoT Firmware API Key — REQUIRED for /api/iot/readings
# Shared secret flashed onto firmware devices
IOT_API_KEY=REPLACE_WITH_RANDOM_SECRET_FOR_IOT_FIRMWARE

# CORS
FRONTEND_URL=http://localhost:3000

# Email Service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# VideoSDK
VIDEOSDK_TOKEN=your_videosdk_token

# Google GenAI
GOOGLE_API_KEY=your_google_api_key

# Payment Gateway (Stripe/PayPal)
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Camoo Payment Gateway — REQUIRED for /api/payments/commercial/*
# Obtain credentials from https://camoo.cm developer portal
CAMOO_API_KEY=your_camoo_api_key
CAMOO_API_SECRET=your_camoo_api_secret
CAMOO_WEBHOOK_SECRET=your_camoo_webhook_secret
CAMOO_BASE_URL=https://api.camoo.cm/v1/payment
# Optional: set a small amount (e.g. 100) to test without real charges
# PAYMENT_TEST_AMOUNT=100

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=mokine-bucket
AWS_REGION=us-east-1
