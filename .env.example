# MokineVeto Environment Variables
# Copy this file to .env and fill in with your values

# ============================================================================
# DATABASE
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mokineveto
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mokineveto

# ============================================================================
# JWT & SECURITY
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
NODE_ENV=development

# ============================================================================
# AWS S3 (File Storage)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mokineveto-bucket
AWS_S3_URL=https://mokineveto-bucket.s3.amazonaws.com

# ============================================================================
# FIREBASE (Push Notifications)
# ============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============================================================================
# TWILIO (SMS & Voice)
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+237xxxxxxxxx

# ============================================================================
# EMAIL SERVICE (AWS SES)
# ============================================================================
AWS_SES_REGION=us-east-1
AWS_SES_EMAIL_FROM=noreply@mokineveto.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-user
SMTP_PASS=your-ses-smtp-password

# ============================================================================
# PAYMENT PROVIDERS
# ============================================================================
# Orange Money (Cameroon)
ORANGE_MONEY_API_KEY=your-orange-api-key
ORANGE_MONEY_BASE_URL=https://api.orange.cm

# MTN Mobile Money (Cameroon)
MTN_MOMO_API_KEY=your-mtn-api-key
MTN_MOMO_BASE_URL=https://api.mtn.cm

# Stripe (optional backup)
STRIPE_API_KEY=your-stripe-api-key
STRIPE_PUBLISHABLE_KEY=your-stripe-public-key

# ============================================================================
# FRONTEND (REACT)
# ============================================================================
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_ENV=development

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=debug
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key

# ============================================================================
# SERVER
# ============================================================================
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# FEATURES FLAGS
# ============================================================================
ENABLE_AI_DIAGNOSTICS=true
ENABLE_MOBILE_MONEY=true
ENABLE_VIDEO_CONSULTATION=false
ENABLE_IOT=false
